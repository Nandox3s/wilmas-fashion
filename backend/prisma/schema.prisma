generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PAYMENT_FAILED
  INVOICING
  INVOICE_AUTHORIZED
  INVOICE_PENDING
  INVOICED
  PREPARING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
  RETURN_REQUESTED
  RETURNED
  EXPIRED
}

enum PaymentStatus {
  CREATED
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  CANCELLED
  REVERSED
  REFUNDED
  ERROR
}

enum InvoiceStatus {
  PENDING
  PROCESSING
  AUTHORIZED
  REJECTED
  FAILED
  ERROR
  PENDING_RETRY
  CANCELLED
  CREDIT_NOTE_ISSUED
}

enum ReservationStatus {
  ACTIVE
  CONFIRMED
  RELEASED
  EXPIRED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ShippingStatus {
  PENDING
  READY_FOR_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURNED
  CANCELLED
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sales           Sale[]
  orders          Order[]
  billingProfiles BillingProfile[]
  productsCreated Product[]        @relation("ProductCreatedBy")
  productsUpdated Product[]        @relation("ProductUpdatedBy")
}

model Product {
  id           Int                    @id @default(autoincrement())
  name         String
  sku          String                 @unique
  brand        String
  category     String
  sizes        Json                   @default("[]")
  color        String
  price        Decimal                @db.Decimal(12, 2)
  discount     Decimal                @default(0) @db.Decimal(5, 2)
  onOffer      Boolean                @default(false)
  stock        Int
  image        String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  createdById  Int?
  updatedById  Int?
  createdBy    User?                  @relation("ProductCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy    User?                  @relation("ProductUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  sales        Sale[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]
}

model Sale {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  quantity  Int
  total     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Order {
  id                   Int                    @id @default(autoincrement())
  reference            String                 @unique
  userId               Int?
  customerName         String
  customerEmail        String
  identificationType   String
  identificationNumber String
  address              String
  city                 String
  phone                String
  subtotal             Decimal                @db.Decimal(12, 2)
  discount             Decimal                @db.Decimal(12, 2)
  tax                  Decimal                @db.Decimal(12, 2)
  shipping             Decimal                @db.Decimal(12, 2)
  total                Decimal                @db.Decimal(12, 2)
  currency             String                 @default("USD")
  status               OrderStatus            @default(PENDING_PAYMENT)
  stockCommittedAt     DateTime?
  expiresAt            DateTime
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  user                 User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  payments             Payment[]
  invoice              Invoice?
  shipment             Shipment?
  notifications        Notification[]
  reservations         InventoryReservation[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?
  sku       String
  name      String
  brand     String
  category  String
  size      String
  color     String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @db.Decimal(12, 2)
  tax       Decimal  @db.Decimal(12, 2)
  total     Decimal  @db.Decimal(12, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model InventoryReservation {
  id        Int               @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  status    ReservationStatus @default(ACTIVE)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product           @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
}

model Payment {
  id                    Int            @id @default(autoincrement())
  orderId               Int
  provider              String
  providerTransactionId String?
  clientTransactionId   String?
  externalTransactionId String?
  idempotencyKey        String         @unique
  amount                Decimal        @db.Decimal(12, 2)
  currency              String         @default("USD")
  status                PaymentStatus  @default(PENDING)
  authorizationCode     String?
  cardBrand             String?
  cardLastDigits        String?
  failureCode           String?
  failureMessage        String?
  confirmedAt           DateTime?
  reversedAt            DateTime?
  refundedAt            DateTime?
  sanitizedResponse     Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  order                 Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events                PaymentEvent[]

  @@unique([clientTransactionId])
  @@unique([externalTransactionId])
}

model PaymentEvent {
  id              Int      @id @default(autoincrement())
  paymentId       Int
  provider        String
  eventType       String
  externalEventId String
  payloadHash     String
  payload         Json?
  processedAt     DateTime @default(now())
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventId])
}

model Invoice {
  id                  Int            @id @default(autoincrement())
  orderId             Int            @unique
  provider            String
  externalId          String?
  status              InvoiceStatus  @default(PENDING)
  establishment       String?
  emissionPoint       String?
  sequential          String?
  accessKey           String?
  authorizationNumber String?
  pdfLocation         String?
  xmlLocation         String?
  rejectionReason     String?
  retryCount          Int            @default(0)
  xmlS3Key            String?
  rideS3Key           String?
  providerResponse    Json?
  issuedAt            DateTime?
  authorizedAt        DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  order               Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events              InvoiceEvent[]

  @@unique([externalId])
  @@unique([accessKey])
}

model InvoiceEvent {
  id              Int      @id @default(autoincrement())
  invoiceId       Int
  eventType       String
  providerEventId String?  @unique
  message         String?
  payload         Json?
  createdAt       DateTime @default(now())
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Shipment {
  id                 Int             @id @default(autoincrement())
  orderId            Int             @unique
  provider           String
  carrierName        String?
  externalShipmentId String?
  trackingNumber     String?
  trackingUrl        String?
  status             ShippingStatus  @default(PENDING)
  shippingCost       Decimal?        @db.Decimal(12, 2)
  estimatedDelivery  DateTime?
  shippedAt          DateTime?
  deliveredAt        DateTime?
  failureReason      String?
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events             ShipmentEvent[]
}

model ShipmentEvent {
  id          Int            @id @default(autoincrement())
  shipmentId  Int
  status      ShippingStatus
  description String?
  location    String?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  shipment    Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id        Int       @id @default(autoincrement())
  type      String
  recipient String
  status    String
  provider  String
  attempts  Int       @default(0)
  sentAt    DateTime?
  lastError String?
  orderId   Int?
  createdAt DateTime  @default(now())
  order     Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model Job {
  id            Int       @id @default(autoincrement())
  type          String
  aggregateId   String
  payload       Json
  status        JobStatus @default(PENDING)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  lockedAt      DateTime?
  lockedBy      String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
}

model BillingProfile {
  id                   Int      @id @default(autoincrement())
  userId               Int
  identificationType   String
  identificationNumber String
  legalName            String
  billingEmail         String
  phone                String?
  billingAddress       String
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
