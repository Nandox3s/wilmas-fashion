    "@aws-sdk/client-sqs": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@prisma/client": "5.6.0",
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "^16.1.4",
    "express": "4.22.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "1.4.5-lts.2",
