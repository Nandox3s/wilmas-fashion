aws_region            = "us-east-1"
environment           = "prod"
enable_networking     = true
enable_rds            = true
enable_backend        = true
enable_storage        = true
enable_queues         = true
enable_invoice_worker = false # enable only after publishing and wiring the tested Lambda image
enable_monitoring     = true
enable_ses_identity   = true
enable_budget         = true
monthly_budget_usd    = 5
budget_email          = "<BUDGET_EMAIL>"
ses_from_email        = "<SES_FROM_EMAIL>"
frontend_origins      = ["https://<AMPLIFY_DOMAIN>"]
