[Unit]
Description=Run Wilmas Fashion Prisma migrations once
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=wilmas
Group=wilmas
WorkingDirectory=/opt/wilmas-fashion/backend
EnvironmentFile=/etc/wilmas-fashion/backend.env
ExecStart=/usr/bin/env HOST=127.0.0.1 UPLOADS_DIR=/opt/wilmas-fashion/uploads /usr/bin/node /opt/wilmas-fashion/backend/node_modules/prisma/build/index.js migrate deploy
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/wilmas-fashion/logs/backend
