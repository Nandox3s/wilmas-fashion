[Unit]
Description=Back up Wilmas Fashion PostgreSQL and uploads
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/wilmas-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/wilmas-fashion/uploads
ReadWritePaths=/opt/wilmas-fashion/backups
